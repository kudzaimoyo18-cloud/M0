# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin login (shared password gate at /admin/login) ---
# Pick something strong. Rotate by updating this value and redeploying.
ADMIN_PASSWORD=""

# --- WhatsApp checkout + customer service ---
NEXT_PUBLIC_WHATSAPP_NUMBER="+263780908101"

# --- Database (Postgres / Neon) ---
# Auto-set by Vercel Storage → Neon integration. For local dev, paste a
# Neon connection string (use the pooled URL ending in ?sslmode=require).
DATABASE_URL=""

# --- Vercel Blob (image storage) ---
# Auto-set by Vercel Storage → Blob integration. For local dev:
# - From Vercel dashboard: Storage → Blob → .env.local tab → copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=""

# --- FX rates ---
# Optional. Falls back to a hardcoded table if unset.
FX_API_URL="https://open.er-api.com/v6/latest/USD"
